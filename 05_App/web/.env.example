VITE_GOOGLE_CALENDAR_ENABLED=false
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

VITE_OUTLOOK_CALENDAR_ENABLED=false
VITE_OUTLOOK_CLIENT_ID=your-azure-ad-application-client-id
# Kun nødvendig hvis Azure-app-registreringen er "Single tenant only" (fx en
# arbejds-/skolekonto-app) — udelad helt, hvis den er registreret som
# multi-tenant/personlige konti. Findes under appens "Overview" i Azure som
# "Directory (tenant) ID".
VITE_OUTLOOK_TENANT_ID=
