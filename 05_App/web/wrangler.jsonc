{
  "name": "boholtsfamilyplatform",
  "compatibility_date": "2026-07-30",
  // Fra Sprint 20: appen har fået en rigtig backend (Hono) ved siden af de
  // statiske filer — "main" kører Worker-koden, som selv server'er de
  // statiske filer for alt der ikke er en /api-rute, via ASSETS-bindingen.
  "main": "./server/index.ts",
  // Ikke-hemmelig, derfor tryg at have direkte i config i stedet for kun i
  // Cloudflare-dashboardets "Variables and Secrets" — dashboard-variablen
  // viste sig at ende som "undefined" efter deploy-kommandoen fik
  // "--env beta" tilføjet, formentlig fordi den er bundet til Workerens
  // ikke-navngivne (produktions-)miljø, ikke det navngivne "beta"-miljø.
  "vars": {
    "GOOGLE_CLIENT_ID": "621931405628-lc7afq5qp0ejmdks5hl9c6b7uclskiie.apps.googleusercontent.com",
    // Sprint 21, Del A: ikke-hemmelig VAPID-nøgle (klienten henter den via
    // /api/push/public-key for at abonnere) — se 21_Sprint21-planen.
    "VAPID_PUBLIC_KEY": "BHVSXcjfORTKBlCSOyokP1Iq9Jwgnuetorda-TEqjEUjvK4hZjp-PE1p4qDJ7Tgq3dywzervtXgt0VKzMxfJZG8",
    "VAPID_SUBJECT": "mailto:nicolajbach12@gmail.com",
    // Sprint 30: hvem der må se indsendt feedback (GET /api/feedback) —
    // ikke-hemmelig, sammenlignes mod den loggede brugers e-mail server-side.
    "ADMIN_EMAIL": "nicolajbach12@gmail.com"
  },
  // Bekræftet identisk med beta i Cloudflare-dashboardets Bindings-fane
  // (Sprint 24, 2026-08-18) — samme secret-navne, samme store_id.
  "secrets_store_secrets": [
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
      "secret_name": "google-client-secret"
    },
    {
      "binding": "GOOGLE_TOKEN_ENCRYPTION_KEY",
      "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
      "secret_name": "google-token-encryption-key"
    },
    {
      "binding": "VAPID_PRIVATE_KEY",
      "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
      "secret_name": "vapid-private-key"
    },
    {
      "binding": "RESEND_API_KEY",
      "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
      "secret_name": "resend-api-key"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Uden dette kører Cloudflares eget SPA-fallback FØR vores
    // Worker-script overhovedet får chancen — enhver rigtig sidenavigation
    // (ikke fetch/XHR) til en ukendt sti fik den cachede index.html med det
    // samme, så /auth/*-ruterne aldrig blev nået.
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boholtsfamilyplatform",
      "database_id": "9de10d3f-3178-4b63-838f-0d7377b0df1b",
      "migrations_dir": "./server/migrations"
    }
  ],
  // Sprint 23: AI-modul (rutine-/ingrediens-forslag). Cloudflare Workers AI
  // kører i egen infrastruktur — ingen API-nøgle, intet data forlader
  // Cloudflare. 10.000 Neurons/dag er gratis; se 23_Sprint23-planen.
  "ai": {
    "binding": "AI"
  },
  // Sprint 28 (2026-08-19): ingen cron-triggers på det ikke-navngivne
  // (produktions-)miljø længere — Nicolaj bekræftede, at familiens
  // rigtige, daglige data ligger i "beta"-miljøet, ikke her, så dette
  // miljø reelt ikke bruges. Cloudflares Free-plan har en KONTO-BRED
  // grænse på 5 cron-triggers i alt, på tværs af alle Workers/miljøer —
  // beta's 3 (session-oprydning, opgave-påmindelser, ugeresumé, se
  // env.beta.triggers nedenfor) er nok til at ramme loftet, hvis dette
  // miljø også havde 3. Selve Workeren kører stadig (så evt. direkte
  // opkald til den ikke bare fejler), den modtager blot aldrig et
  // scheduled()-kald.
  "triggers": {
    "crons": []
  },
  // Samme mønster som secrets_store_secrets ovenfor: slået til i
  // dashboardet, men uden dette forsvinder det ved næste Git-udløste
  // deploy. Logs persisteres (så et fejlet kald kan slås op bagefter), traces
  // er bevidst fra — ingen nuværende behov, og det er den dyrere af de to.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // "beta"-miljøet deployer til en separat Worker (egen URL), brugt af et
  // andet Cloudflare Workers-projekt der forgrener sig fra `develop` i
  // stedet for `main` — så nye funktioner kan testes på en rigtig, delt
  // URL, før de merges til den rigtige produktion. Aktiveres med
  // `wrangler deploy --env beta`; ingen effekt uden det flag. Har sin EGEN
  // D1-database, adskilt fra produktion, så beta-test aldrig kan ramme
  // rigtig familiedata.
  "env": {
    "beta": {
      "name": "boholtsfamilyplatform-beta",
      "main": "./server/index.ts",
      "vars": {
        "GOOGLE_CLIENT_ID": "621931405628-lc7afq5qp0ejmdks5hl9c6b7uclskiie.apps.googleusercontent.com",
        "VAPID_PUBLIC_KEY": "BHVSXcjfORTKBlCSOyokP1Iq9Jwgnuetorda-TEqjEUjvK4hZjp-PE1p4qDJ7Tgq3dywzervtXgt0VKzMxfJZG8",
        "VAPID_SUBJECT": "mailto:nicolajbach12@gmail.com",
        "ADMIN_EMAIL": "nicolajbach12@gmail.com"
      },
      // Ligesom "vars" ovenfor: bindinger tilføjet kun via dashboardets
      // Bindings-fane forsvinder ved næste Git-udløste deploy ("Cannot read
      // properties of undefined (reading 'get')") — skal stå her for at
      // overleve fremtidige deploys, inkl. deploys udløst af rene
      // dokumentations-commits.
      "secrets_store_secrets": [
        {
          "binding": "GOOGLE_CLIENT_SECRET",
          "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
          "secret_name": "google-client-secret"
        },
        {
          "binding": "GOOGLE_TOKEN_ENCRYPTION_KEY",
          "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
          "secret_name": "google-token-encryption-key"
        },
        {
          "binding": "VAPID_PRIVATE_KEY",
          "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
          "secret_name": "vapid-private-key"
        },
        {
          "binding": "RESEND_API_KEY",
          "store_id": "2bc6325a385d4ca3bc555d66f5453a21",
          "secret_name": "resend-api-key"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Uden dette kører Cloudflares eget SPA-fallback FØR vores
        // Worker-script overhovedet får chancen — enhver rigtig
        // sidenavigation (ikke fetch/XHR) til en ukendt sti fik den cachede
        // index.html med det samme, så /auth/*-ruterne aldrig blev nået.
        "run_worker_first": ["/auth/*", "/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boholtsfamilyplatform-beta",
          "database_id": "cd369f99-abc2-44e0-9647-300ee6d85a13"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      // Det reelt brugte miljø (Nicolaj og Christines PWA på hjemmeskærmen
      // peger her, ikke på det ikke-navngivne produktionsmiljø ovenfor) —
      // har derfor alle tre cron-triggers. Se den ikke-navngivne sektions
      // "triggers"-kommentar for hvorfor produktion har en tom liste
      // (Cloudflares konto-brede 5-cron-loft på Free-planen).
      "triggers": {
        "crons": ["0 4 * * *", "*/5 * * * *", "0 17 * * SUN"]
      },
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        }
      }
    }
  }
}
