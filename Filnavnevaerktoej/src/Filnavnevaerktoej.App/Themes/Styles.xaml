<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Farvepalet -->
    <SolidColorBrush x:Key="PrimaerBlaaBrush" Color="#0063B1" />
    <SolidColorBrush x:Key="PrimaerBlaaHoverBrush" Color="#004E8C" />
    <SolidColorBrush x:Key="SuccesGroenBrush" Color="#2EA043" />
    <SolidColorBrush x:Key="SuccesGroenBaggrundBrush" Color="#E6F4EA" />
    <SolidColorBrush x:Key="FejlRoedBrush" Color="#D13438" />
    <SolidColorBrush x:Key="FejlRoedBaggrundBrush" Color="#FCE8E8" />
    <SolidColorBrush x:Key="AdvarselGulBrush" Color="#B88600" />
    <SolidColorBrush x:Key="AdvarselGulBaggrundBrush" Color="#FFF6DC" />
    <SolidColorBrush x:Key="UaendretGraaBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="UaendretGraaBaggrundBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="BaggrundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="KantBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="TekstBrush" Color="#1F1F1F" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource BaggrundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TekstBrush}" />
    </Style>

    <Style x:Key="OverskriftStil" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="UnderoverskriftStil" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#5B5B5B" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SektionsOverskriftStil" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- Primær knap (blå) -->
    <Style x:Key="PrimaerKnapStil" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaerBlaaBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource PrimaerBlaaHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sekundær knap (hvid med kant) -->
    <Style x:Key="SekundaerKnapStil" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TekstBrush}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="BorderBrush" Value="{StaticResource KantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F0F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="BorderBrush" Value="{StaticResource KantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GruppeKortStil" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource KantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDEDED" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="BorderBrush" Value="{StaticResource KantBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
    </Style>

</ResourceDictionary>
