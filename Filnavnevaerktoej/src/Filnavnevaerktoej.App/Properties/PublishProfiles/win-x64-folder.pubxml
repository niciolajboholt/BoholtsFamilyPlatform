<Project>
  <!--
    Publicerer Filnavneværktøj som en mappebaseret, selvstændig Windows x64-installation (fallback,
    hvis single-file-varianten af en eller anden grund ikke er ønsket).
    Kør fra solution-roden: dotnet publish src\Filnavnevaerktoej.App -p:PublishProfile=win-x64-folder
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\..\artifacts\publish\win-x64\folder\</PublishDir>
  </PropertyGroup>
</Project>
