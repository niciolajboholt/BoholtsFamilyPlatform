<Window x:Class="Filnavnevaerktoej.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Om Filnavneværktøj" Height="420" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="/Resources/app.ico" Width="48" Height="48" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Filnavneværktøj" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionTekst" Text="Version 1.0.0" Foreground="#5B5B5B" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap"
                    Text="Et selvstændigt Windows-program til sikker og struktureret masseomdøbning af filer - med levende forhåndsvisning, valideringskontrol og fuld fortrydelse." />

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Teknologi" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="C#, .NET 8, WPF (MVVM). Kører uden internetforbindelse og uden administratorrettigheder." TextWrapping="Wrap" />

            <TextBlock Text="Placering af log- og historikfiler" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock x:Name="LogStiTekst" TextWrapping="Wrap" />
            <TextBlock x:Name="HistorikStiTekst" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="ProfilStiTekst" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Button Grid.Row="3" Content="_Luk" Click="OnLukClick" Style="{StaticResource PrimaerKnapStil}" HorizontalAlignment="Right" />
    </Grid>
</Window>
