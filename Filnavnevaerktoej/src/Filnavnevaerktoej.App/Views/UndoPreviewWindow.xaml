<Window x:Class="Filnavnevaerktoej.App.Views.UndoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Filnavnevaerktoej.App.Converters"
        Title="Fortryd omdøbning - forhåndsvisning" Height="560" Width="880" MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:StatusTilBaggrundConverter x:Key="StatusTilBaggrundConverter" />
        <conv:StatusTilTekstConverter x:Key="StatusTilTekstConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Fortryd omdøbning" Style="{StaticResource OverskriftStil}" />
        <TextBlock Grid.Row="1" Style="{StaticResource UnderoverskriftStil}"
                    Text="Nedenfor vises, hvilke filer der vil få deres oprindelige navn tilbage. Filer med fejl kan ikke fortrydes." />

        <DataGrid Grid.Row="2" x:Name="ForhaandsvisningGrid" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusTilBaggrundConverter}}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusTilTekstConverter}}" Width="0.8*" />
                <DataGridTextColumn Header="Nuværende filnavn" Binding="{Binding GammeltFilnavn}" Width="1.8*" />
                <DataGridTextColumn Header="Oprindeligt filnavn" Binding="{Binding NytFilnavn}" Width="1.8*" />
                <DataGridTextColumn Header="Mappe" Binding="{Binding Mappe}" Width="2*" />
                <DataGridTextColumn Header="Bemærkning" Binding="{Binding Bemaerkning}" Width="1.6*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Annuller" Click="OnAnnullerClick" Style="{StaticResource SekundaerKnapStil}" Margin="0,0,8,0" />
            <Button Content="_Fortryd disse filer" Click="OnFortsaetClick" Style="{StaticResource PrimaerKnapStil}" />
        </StackPanel>
    </Grid>
</Window>
