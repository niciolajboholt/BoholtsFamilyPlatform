<UserControl x:Class="Filnavnevaerktoej.App.Views.ConfigureRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Filnavnevaerktoej.App.Converters">

    <UserControl.Resources>
        <conv:StatusTilBaggrundConverter x:Key="StatusTilBaggrundConverter" />
        <conv:StatusTilTekstConverter x:Key="StatusTilTekstConverter" />
        <conv:StringIkkeTomTilSynlighedConverter x:Key="StringIkkeTomTilSynlighedConverter" />
        <conv:TilfoejKraeverBestemtTekstConverter x:Key="TilfoejKraeverBestemtTekstConverter" />
        <conv:TilfoejKraeverPositionConverter x:Key="TilfoejKraeverPositionConverter" />
        <conv:BoolTilSynlighedConverter x:Key="BoolTilSynlighedConverter" />

        <Style x:Key="RegelKortStil" TargetType="Border" BasedOn="{StaticResource GruppeKortStil}" />
        <Style x:Key="RegelFeltLabelStil" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5B5B5B" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tilpas filnavne" Style="{StaticResource OverskriftStil}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.35*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- VENSTRE: Omdøbningsregler -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- A. Slet tekst -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="A) Slet tekst - Aktivér" FontWeight="SemiBold" IsChecked="{Binding SletRegel.ErAktiveret}" />
                            <TextBlock Text="Tekst der skal slettes" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding SletRegel.TekstDerSkalSlettes, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Forskel på store og små bogstaver" Margin="0,8,0,0"
                                      IsChecked="{Binding SletRegel.ForskelPaaStoreSmaaBogstaver}" />
                        </StackPanel>
                    </Border>

                    <!-- B. Erstat tekst -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="B) Erstat tekst - Aktivér" FontWeight="SemiBold" IsChecked="{Binding ErstatRegel.ErAktiveret}" />
                            <TextBlock Text="Find" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding ErstatRegel.Find, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Erstat med" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding ErstatRegel.ErstatMed, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Forskel på store og små bogstaver" Margin="0,8,0,0"
                                      IsChecked="{Binding ErstatRegel.ForskelPaaStoreSmaaBogstaver}" />
                            <TextBlock Text="Omfang" Style="{StaticResource RegelFeltLabelStil}" />
                            <ComboBox ItemsSource="{x:Static conv:EnumOptions.ReplaceScopeOptions}" DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi"
                                      SelectedValue="{Binding ErstatRegel.Omfang}" />
                        </StackPanel>
                    </Border>

                    <!-- C. Tilføj tekst -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="C) Tilføj tekst - Aktivér" FontWeight="SemiBold" IsChecked="{Binding TilfoejRegel.ErAktiveret}" />
                            <TextBlock Text="Tekst der skal tilføjes" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding TilfoejRegel.Tekst, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Placering" Style="{StaticResource RegelFeltLabelStil}" />
                            <ComboBox ItemsSource="{x:Static conv:EnumOptions.AddTextPlacementOptions}" DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi"
                                      SelectedValue="{Binding TilfoejRegel.Placering}" />

                            <StackPanel Visibility="{Binding TilfoejRegel.Placering, Converter={StaticResource TilfoejKraeverBestemtTekstConverter}}">
                                <TextBlock Text="Bestemt tekst" Style="{StaticResource RegelFeltLabelStil}" />
                                <TextBox Text="{Binding TilfoejRegel.BestemtTekst, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding TilfoejRegel.Placering, Converter={StaticResource TilfoejKraeverPositionConverter}}">
                                <TextBlock Text="Tegnposition (1 = før første tegn)" Style="{StaticResource RegelFeltLabelStil}" />
                                <TextBox Text="{Binding TilfoejRegel.Tegnposition, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- D. Regex -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="D) Regex-omdøbning - Aktivér regex" FontWeight="SemiBold" IsChecked="{Binding RegexRegel.ErAktiveret}" />
                            <TextBlock Text="Regex-mønster" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding RegexRegel.Moenster, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RegexFejlBesked, Converter={StaticResource StringIkkeTomTilSynlighedConverter}}" Value="Visible">
                                                <Setter Property="BorderBrush" Value="{StaticResource FejlRoedBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding RegexFejlBesked}" Foreground="{StaticResource FejlRoedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding RegexFejlBesked, Converter={StaticResource StringIkkeTomTilSynlighedConverter}}" />
                            <TextBlock Text="Regex-erstatning (brug $1, $2 osv. for capture groups)" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding RegexRegel.Erstatning, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Forskel på store og små bogstaver" Margin="0,8,0,0" IsChecked="{Binding RegexRegel.ForskelPaaStoreSmaaBogstaver}" />
                            <CheckBox Content="Kun første match" IsChecked="{Binding RegexRegel.KunFoersteMatch}" />
                            <TextBlock Text="Anvendelsesområde" Style="{StaticResource RegelFeltLabelStil}" />
                            <ComboBox ItemsSource="{x:Static conv:EnumOptions.RegexTargetOptions}" DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi"
                                      SelectedValue="{Binding RegexRegel.Maal}" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontStyle="Italic" Foreground="#5B5B5B"
                                       Text="Eksempel: Mønster '^FloorPlan-(.+)-Niveau(\d+)$' med erstatning '$1 - Niveau $2' laver 'FloorPlan-NB5_K01_H1_E0-Niveau0' om til 'NB5_K01_H1_E0 - Niveau 0'." />
                        </StackPanel>
                    </Border>

                    <!-- E. Store/små bogstaver -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="E) Store/små bogstaver - Aktivér" FontWeight="SemiBold" IsChecked="{Binding StoreSmaaRegel.ErAktiveret}" />
                            <TextBlock Text="Tilstand" Style="{StaticResource RegelFeltLabelStil}" />
                            <ComboBox ItemsSource="{x:Static conv:EnumOptions.CaseChangeModeOptions}" DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi"
                                      SelectedValue="{Binding StoreSmaaRegel.Tilstand}" />
                        </StackPanel>
                    </Border>

                    <!-- F. Nummerering -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <CheckBox Content="F) Nummerering - Aktivér nummerering" FontWeight="SemiBold" IsChecked="{Binding NummereringRegel.ErAktiveret}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Startnummer" Style="{StaticResource RegelFeltLabelStil}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NummereringRegel.Startnummer, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Trin" Style="{StaticResource RegelFeltLabelStil}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NummereringRegel.Trin, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Antal cifre" Style="{StaticResource RegelFeltLabelStil}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding NummereringRegel.AntalCifre, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Placering" Style="{StaticResource RegelFeltLabelStil}" />
                            <ComboBox ItemsSource="{x:Static conv:EnumOptions.NumberingPlacementOptions}" DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi"
                                      SelectedValue="{Binding NummereringRegel.Placering}" />
                            <TextBlock Text="Tekst før nummer" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding NummereringRegel.TekstFoerNummer, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Tekst efter nummer" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding NummereringRegel.TekstEfterNummer, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- G. Filendelser -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <TextBlock Text="G) Avanceret: Filendelser" Style="{StaticResource SektionsOverskriftStil}" Margin="0" />
                            <CheckBox Content="Tillad ændring af filendelser" IsChecked="{Binding TilladAendringAfFilendelser}" Margin="0,6,0,0" />
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AdvarselGulBrush}"
                                       Visibility="{Binding TilladAendringAfFilendelser, Converter={StaticResource BoolTilSynlighedConverter}}"
                                       Text="Advarsel: Hvis filendelsen ændres, kan filerne blive ubrugelige for de programmer, der normalt åbner dem. Brug kun denne indstilling, hvis du er sikker på konsekvenserne." />
                        </StackPanel>
                    </Border>

                    <!-- Profiler -->
                    <Border Style="{StaticResource RegelKortStil}">
                        <StackPanel>
                            <TextBlock Text="Profiler" Style="{StaticResource SektionsOverskriftStil}" Margin="0" />
                            <ListBox ItemsSource="{Binding ProfilNavne}" SelectedItem="{Binding ValgtProfilNavn}" Height="90" Margin="0,6,0,0" />
                            <TextBlock Text="Profilnavn (til at gemme/omdøbe under)" Style="{StaticResource RegelFeltLabelStil}" />
                            <TextBox Text="{Binding ProfilNavnInput, UpdateSourceTrigger=PropertyChanged}" />
                            <UniformGrid Rows="1" Columns="4" Margin="0,8,0,0">
                                <Button Content="_Gem profil" Command="{Binding GemProfilCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="0,0,4,0" />
                                <Button Content="_Indlæs profil" Command="{Binding IndlaesProfilCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="4,0,4,0" />
                                <Button Content="_Omdøb profil" Command="{Binding OmdoebProfilCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="4,0,4,0" />
                                <Button Content="_Slet profil" Command="{Binding SletProfilCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="4,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="{Binding ProfilStatusBesked}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding ProfilStatusBesked, Converter={StaticResource StringIkkeTomTilSynlighedConverter}}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- HØJRE: Live forhåndsvisning -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Live forhåndsvisning" Style="{StaticResource SektionsOverskriftStil}" Margin="0,0,0,6" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{x:Static conv:EnumOptions.ForhaandsvisningsFilterOptions}"
                              DisplayMemberPath="Tekst" SelectedValuePath="Vaerdi" SelectedValue="{Binding AktivtFilter}" />
                    <TextBox Grid.Column="2" Text="{Binding Soegetekst, UpdateSourceTrigger=PropertyChanged}" Tag="Søg i filnavne..." />
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding ForhaandsvisningVisning}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusTilBaggrundConverter}}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource StatusTilTekstConverter}}" Width="0.7*" />
                        <DataGridTextColumn Header="Gammelt filnavn" Binding="{Binding GammeltFilnavn}" Width="1.6*" />
                        <DataGridTextColumn Header="Nyt filnavn" Binding="{Binding NytFilnavn}" Width="1.6*" />
                        <DataGridTextColumn Header="Mappe" Binding="{Binding Mappe}" Width="1.6*" />
                        <DataGridTextColumn Header="Bemærkning" Binding="{Binding Bemaerkning}" Width="1.6*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Style="{StaticResource GruppeKortStil}" Margin="0,10,0,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding AntalFundet, StringFormat='Fundet: {0}'}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding AntalAendres, StringFormat='Ændres: {0}'}" Foreground="{StaticResource SuccesGroenBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding AntalUaendret, StringFormat='Uændrede: {0}'}" Foreground="{StaticResource UaendretGraaBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding AntalAdvarsler, StringFormat='Advarsler: {0}'}" Foreground="{StaticResource AdvarselGulBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding AntalFejl, StringFormat='Fejl: {0}'}" Foreground="{StaticResource FejlRoedBrush}" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
