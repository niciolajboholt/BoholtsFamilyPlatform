<Window x:Class="Filnavnevaerktoej.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Filnavnevaerktoej.App.Converters"
        Title="Historik" Height="620" Width="920" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:OperationStatusTilTekstConverter x:Key="OperationStatusTilTekstConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Historik over omdøbninger" Style="{StaticResource OverskriftStil}" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Operationer}" SelectedItem="{Binding ValgtOperation}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dato" Binding="{Binding Dato, StringFormat='dd-MM-yyyy HH:mm:ss'}" Width="1.4*" />
                <DataGridTextColumn Header="Mappe" Binding="{Binding Mappe}" Width="2.6*" />
                <DataGridTextColumn Header="Antal filer" Binding="{Binding AntalFiler}" Width="0.8*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource OperationStatusTilTekstConverter}}" Width="1*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource GruppeKortStil}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Detaljer for valgt operation" Style="{StaticResource SektionsOverskriftStil}" Margin="0,0,0,4" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding ValgtOperation.Operation.Entries}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Gammelt filnavn" Binding="{Binding OprindeligtFilnavn}" Width="1.6*" />
                        <DataGridTextColumn Header="Nyt filnavn" Binding="{Binding NytFilnavn}" Width="1.6*" />
                        <DataGridTextColumn Header="Resultat" Binding="{Binding Resultat}" Width="0.9*" />
                        <DataGridTextColumn Header="Fejlbesked" Binding="{Binding Fejlbesked}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Opdater" Command="{Binding OpdaterCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="0,0,8,0" />
            <Button Content="_Fortryd valgt operation" Command="{Binding FortrydCommand}" Style="{StaticResource SekundaerKnapStil}" Margin="0,0,8,0" />
            <Button Content="_Luk" Click="OnLukClick" Style="{StaticResource PrimaerKnapStil}" />
        </StackPanel>
    </Grid>
</Window>
